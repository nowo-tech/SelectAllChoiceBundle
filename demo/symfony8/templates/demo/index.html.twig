{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.page_title'|trans }} – {{ 'demo.symfony_version'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.heading'|trans,
        intro: 'demo.description'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.heading'|trans, kind: 'form', testid: 'demo-case'} %}
        {% block section_body %}
            {{ form_start(form, { attr: { id: 'demo-form', class: 'nowo-ui-form', novalidate: 'novalidate' } }) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {% if child.vars.name == 'categories' %}
                            <p class="nowo-ui-muted">{{ 'demo.styles_hint'|trans }}</p>
                        {% endif %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                {% do form.submit.setRendered %}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label|trans({}, 'messages') }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
