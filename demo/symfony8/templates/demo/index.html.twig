{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.page_title'|trans }} – {{ 'demo.symfony_version'|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.heading'|trans,
        intro: 'demo.description'|trans,
    }) }}
{% endblock %}

{% block body %}
    <section class="nowo-ui-card" data-testid="demo-case">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
                {% for child in form %}
                    {% if not child.rendered %}
                        {% if child.vars.name == 'categories' %}
                            <p class="nowo-ui-muted">{{ 'demo.styles_hint'|trans }}</p>
                        {% endif %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>
{% endblock %}
