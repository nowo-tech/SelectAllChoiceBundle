{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. The scripts are
    the bundle's own select-all runtime. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _locale = app.request.locale|default('en') %}
{% set nowo_ui_demo_platform = {
    bundle: 'Select All Choice',
    home_route: 'demo_index',
    home_params: {_locale: _locale},
    repository: 'https://github.com/nowo-tech/SelectAllChoiceBundle',
    translation_domain: 'messages',
    locales: ['en', 'es'],
    nav: [
        {label: 'demo.heading', route: 'demo_index', params: {_locale: _locale}, section: 'demo.brand'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {% block styles %}{% endblock %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# Standalone IIFE always available; Vite app.js is optional (REQ-DEMO-013 e2e). #}
    <script src="{{ asset('select-all-choice.js', 'nowo_select_all_choice') }}" defer></script>
    <script type="module" src="{{ asset('build/assets/app.js') }}"></script>
    {% block scripts %}{% endblock %}
{% endblock %}
